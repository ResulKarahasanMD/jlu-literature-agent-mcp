# Required by Unpaywall and recommended for polite scholarly API access.
LITLIB_EMAIL=your-jlu-email@mails.jlu.edu.cn

# Optional writable workspace for wheel/global installs. Editable clones use the clone root.
# LITLIB_ROOT=D:\Research\literature-library-data

# Optional. On a clone stored on D:, the default is D:\LitLibRuntime.
# LITLIB_RUNTIME_ROOT=D:\LitLibRuntime

# Optional fallback for Zotero imported attachments when Local API enclosure paths are absent.
# LITLIB_ZOTERO_DATA=D:\ZoteroData

# Set to 1 to enforce that PDFs, state, caches, and browser data stay on D:.
# Students without a D: drive should use 0 and choose another sufficiently large location.
LITLIB_REQUIRE_D_DRIVE=0

# Off by default. When enabled, institution-login cookies are saved only as a DPAPI-encrypted file.
LITLIB_EXPORT_SESSION_COOKIES=0

# Optional comma-separated additions when JLU changes its official IdP hostname.
# Verify ownership before adding a host; credentials are blocked on all other hosts.
# LITLIB_JLU_IDP_HOSTS=new-idp.jlu.edu.cn
