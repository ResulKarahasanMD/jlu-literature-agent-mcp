# Unpaywall için zorunlu; akademik API'lere nazik erişim için de önerilir.
LITLIB_EMAIL=your-jlu-email@mails.jlu.edu.cn

# Wheel/global kurulumlar için isteğe bağlı yazılabilir çalışma alanı. Düzenlenebilir klonlar klon kökünü kullanır.
# LITLIB_ROOT=D:\Research\literature-library-data

# İsteğe bağlı. D:'de duran bir klonda varsayılan D:\LitLibRuntime'dır.
# LITLIB_RUNTIME_ROOT=D:\LitLibRuntime

# Local API enclosure yolları yoksa Zotero'ya içe aktarılmış ekler için isteğe bağlı yedek yol.
# LITLIB_ZOTERO_DATA=D:\ZoteroData

# PDF'lerin, durum verisinin, önbelleklerin ve tarayıcı verisinin D:'de kalmasını zorunlu kılmak için 1 yapın.
# D: sürücüsü olmayanlar 0 kullanmalı ve yeterince büyük başka bir konum seçmeli.
LITLIB_REQUIRE_D_DRIVE=0

# Varsayılan olarak kapalı. Açılırsa kurum girişi çerezleri yalnız DPAPI ile şifreli dosya olarak saklanır.
LITLIB_EXPORT_SESSION_COOKIES=0

# JLU resmi IdP host adını değiştirirse virgülle ayrılmış isteğe bağlı eklemeler.
# Bir host eklemeden önce sahipliğini doğrulayın; kimlik bilgileri diğer tüm host'larda engellenir.
# LITLIB_JLU_IDP_HOSTS=new-idp.jlu.edu.cn

# Bezmialem Vakıf Üniversitesi (macOS/GlobalProtect VPN). Hiçbir parola saklanmaz ya da kullanılmaz:
# kimlik doğrulamayı VPN istemcisi yapar; LitLib yalnız doğrudan rotaları kullanır, JLU ağ geçidini/IdP'sini atlar.
# LITLIB_INSTITUTION=bvu
# BVU'nun abone olduğu bir makalenin sayfası; ön kontrol, HTML'inde aşağıdaki kalıbın geçmesini ister.
# LITLIB_BVU_PROBE_URL=https://doi.org/<subscribed-doi>
# Varsayılan desen "Bezmialem", "Bezm-i Alem" ve "Bezmi Alem" yazımlarını kapsar (harf duyarsız).
# LITLIB_BVU_ACCESS_PATTERN=Bezm[-\s]?i[-\s]?alem
